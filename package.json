{
  "name": "dsh-study-alongwith-ai",
  "version": "0.2.0",
  "type": "module",
  "description": "AI 伴学（study-alongwith-AI）：把教材、对话、证据、复习闭环做成 DeepSeek Harness 的可安装 bundle。 · Study-alongwith-AI companion for DSH: textbook + Socratic dialogue + evidence-backed mastery + spaced review.",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "study",
    "learning",
    "education",
    "socratic",
    "spaced-repetition",
    "flashcard",
    "knowledge-graph"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/plugin-host/index.js",
  "exports": {
    ".": {
      "default": "./lib/plugin-host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:structure": "node scripts/selfcheck.mjs",
    "check:build": "node scripts/verify-build.mjs",
    "check:install": "node scripts/verify-install.mjs",
    "check:preset": "node scripts/verify-preset.mjs",
    "check": "npm run check:encoding && npm run check:structure && npm run build && npm run check:build && npm run check:install && npm run check:preset && npm test",
    "test": "node --test --test-isolation=none \"packages/*/tests/*.test.ts\"",
    "test:core": "node --test --test-isolation=none \"packages/core/tests/*.test.ts\"",
    "test:ingest": "node --test --test-isolation=none \"packages/ingest/tests/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  }
}
